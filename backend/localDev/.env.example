# MongoDB Configuration
# For local development with MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mtg-local?retryWrites=true&w=majority
MONGO_DB_NAME=mtg-local
MONGO_COLLECTION=cards

# For local MongoDB
# MONGO_URI=mongodb://localhost:27017

# Scryfall API Configuration (optional, uses default if not set)
SCRYFALL_API_URL=https://api.scryfall.com
SCRYFALL_TIMEOUT=5000

# AWS Configuration (for production)
# AWS_REGION=us-east-1
# DYNAMODB_TABLE=mtg-cards
# CACHE_TTL=604800  # 7 days in seconds

# Set NODE_ENV to development to use MongoDB
NODE_ENV=development

# Set to false to disable MongoDB even in development
# USE_MONGODB=true
